# URL del backend. Si no se define, el frontend usa http://localhost:8000,
# o sea el backend que cada quien corre en su propia maquina.
#
# Copien este archivo a .env.local (esta en .gitignore) y descomenten la
# linea de abajo solo si quieren pegarle a un backend compartido:
#
# VITE_API_URL=https://el-backend-desplegado.example.com
