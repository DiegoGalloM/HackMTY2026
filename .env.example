# Consigue tu key en http://api.nessieisreal.com/ (login con GitHub -> perfil)
NESSIE_API_KEY=your_key_here
NESSIE_BASE_URL=http://api.nessieisreal.com

# Si Nessie se cae (pasó en HackMTY 2025) o quieren desarrollar sin llamar
# a la API real, pongan esto en "true" y el backend usa datos simulados
# locales con la misma forma que la respuesta real.
USE_MOCK_NESSIE=true

# Para la capa de insights/IA (opcional, según la idea final)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

CORS_ORIGINS=http://localhost:5173,tauri://localhost

USE_SNOWFLAKE=false
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=

# Firma de los tokens de sesión (registro / login). Si se deja vacío, el backend
# genera uno aleatorio al arrancar y avisa con un warning: sirve para desarrollar,
# pero los tokens se invalidan en cada reinicio y no sirven entre varios workers.
# Mínimo 32 caracteres: el backend se niega a arrancar con uno más corto,
# porque un secreto corto se rompe offline y con él se firma un token para
# cualquier usuario.
# Generen uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=720

# --- Núcleo financiero (ver docs/FINANCIAL_CORE.md) --------------------------
# Sin Snowflake, el núcleo usa sqlite en memoria (se reinicia con el proceso).
# Un path lo vuelve persistente entre reinicios: LOCAL_DB_PATH=./data/local.db
LOCAL_DB_PATH=
# Proveedor de pagos del cobro con QR. "demo" aprueba el pago sin servicios
# externos pero produce el MISMO evento autoritativo que un webhook real.
PAYMENT_PROVIDER=demo
# Fuente de transacciones de la tarjeta de negocio: "demo" | "nessie".
TRANSACTION_PROVIDER=demo
# Redacción de las respuestas del asistente: "auto" usa Anthropic si hay key,
# si no Snowflake Cortex (cuando USE_SNOWFLAKE=true), si no plantillas.
# También: anthropic | cortex | none. Los números NUNCA salen del LLM.
LLM_PROVIDER=auto
CORTEX_MODEL=claude-sonnet-4-5
ANTHROPIC_MODEL=claude-opus-5
# URL pública del frontend (para el link del QR cuando se despliega). Vacío =
# el frontend usa su propio origen.
PUBLIC_APP_URL=
